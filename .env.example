# Banco de Dados (SQLite para dev local, ou PostgreSQL / Supabase para produção)
DATABASE_URL="file:./dev.db"

# URLs da Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="NexusDrop Store"

# ==========================================
# 🔌 CREDENCIAIS DE INTEGRAÇÕES & MARKETPLACES
# ==========================================

# Shopify (Admin API)
SHOPIFY_STORE_DOMAIN="sua-loja.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Nuvemshop (Tiendanube API)
NUVEMSHOP_USER_ID="1234567"
NUVEMSHOP_ACCESS_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Mercado Livre (Mercado Pago / Developers)
MERCADOLIVRE_APP_ID="xxxxxxxxxxxxxxxx"
MERCADOLIVRE_SECRET_KEY="xxxxxxxxxxxxxxxx"

# CJ Dropshipping (API Oficial)
CJ_DROPSHIPPING_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
